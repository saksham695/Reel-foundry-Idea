# Script writer — required
ANTHROPIC_API_KEY=

# Hindi narration — required unless you run with VOICE_ENGINE=mock
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v2
SARVAM_SPEAKER=anushka
SARVAM_LANGUAGE=hi-IN

# sarvam = the real thing. silent = instant silent WAV for pipeline smoke tests.
# say = macOS `say` (real audio, but ~60s per line under Rosetta on this machine).
VOICE_ENGINE=sarvam

# Stock visuals — required (free, instant signup at pexels.com/api)
PEXELS_API_KEY=

# Word-level captions. Leave unset and captions fall back to even distribution
# across each beat, which is good enough to judge a first cut.
WHISPER_CLI=
WHISPER_MODEL=
