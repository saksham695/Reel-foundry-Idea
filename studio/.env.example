# --- writer -------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- voice --------------------------------------------------------------
# sarvam  Bulbul, real Indian neural voices. What you ship with.
# local   macOS `say` (Lekha for Hindi). Real audio, robotic, ~10x realtime here.
# silent  correctly-sized silence. Instant, for checking layout and timing.
VOICE_ENGINE=sarvam
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v2
SARVAM_LANGUAGE=hi-IN
SAY_VOICE=Lekha

# --- images -------------------------------------------------------------
# vector  local SVG frames. No key, no cost, deterministic. Default.
# flux    Replicate FLUX.schnell, ~$0.003 an image.
# pexels  stock stills, one per line, held as a slideshow.
IMAGE_PROVIDER=vector
REPLICATE_API_TOKEN=
PEXELS_API_KEY=
# The flipbook. 8 frames at 8fps is a talking character; 1fps is a slideshow.
FRAMES_PER_LINE=8
IMAGE_FPS=8

# --- captions -----------------------------------------------------------
# Leave unset and words are spread across each line by character weight,
# which is good enough to judge a first cut.
WHISPER_CLI=
WHISPER_MODEL=
